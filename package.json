{
  "name": "examstitch.com",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen-types": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/lib/supabase/types.generated.ts",
    "prebuild": "npm run typecheck",
    "check-slugs": "npx tsx scripts/check-category-slugs.ts",
    "check-db-health": "npx tsx scripts/check-db-health.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "^14.2.35",
    "openai": "^6.33.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.4.1",
    "typescript": "^6.0.2",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.5"
  }
}
